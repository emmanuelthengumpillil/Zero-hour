# Zero Hour Environment Variables

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Configuration
RESEND_API_KEY=re_123456789_your_key_here
RESEND_FROM_EMAIL="Zero Hour <onboarding@resend.dev>"

# Encryption at rest (32-byte hex string or secure passphrase for AES-256-GCM)
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Python Analytics Microservice URL
PYTHON_ANALYTICS_URL=http://127.0.0.1:8000
